# =============================================================================
# Molde do .env de producao (FABIANO-14)
#
# Copiar para .env AO LADO do docker-compose.yml, preencher, e travar:
#     cp .env.example .env && chmod 600 .env
#
# O .env de verdade nunca entra no Git (.gitignore ja cobre). Este arquivo,
# so com placeholders, entra.
#
# Origem dos valores: /etc/poc-fabiano.env na EC2, que e o EnvironmentFile do
# servico systemd em producao hoje. Migrar copiando de la, nao reinventando.
# =============================================================================

# ---- Imagem -----------------------------------------------------------------
# Dono do pacote no GitHub Container Registry (usuario ou organizacao).
GHCR_OWNER=preencher

# Tag da imagem a rodar. Em deploy normal e o SHA curto do commit; rollback e
# so voltar esta linha para a tag anterior e subir de novo.
BACKEND_TAG=latest

# ---- Banco (RDS) ------------------------------------------------------------
DB_HOST=preencher.rds.amazonaws.com
DB_PORT=3306
DB_NAME=preencher
DB_USER=preencher
DB_PASSWORD=preencher

# ---- Autenticacao -----------------------------------------------------------
# application.properties declara jwt.secret=${JWT_SECRET} SEM valor padrao — a
# aplicacao nao sobe se esta variavel faltar. E o comportamento correto: um
# segredo padrao que funciona em silencio e pior do que uma falha na subida.
JWT_SECRET=preencher-segredo-longo-e-aleatorio
JWT_EXPIRATION=86400000

# ---- URLs e CORS ------------------------------------------------------------
# So tem efeito no profile 'dev': e o prefixo do link de imagem servida do disco
# (LocalImageStorageService). Em prod/homolog o storage e o S3 e quem manda e o
# AWS_S3_BASE_URL — esta variavel fica inerte. Mantida para o dev local.
APP_BASE_URL=https://preencher

# URL do FRONTEND. Monta os links publicos de quiz, ranking e survey
# (app.frontend-url no application.properties). Estava faltando neste molde e
# tambem no .env da maquina — sem ela o padrao e 'http://localhost:4200', e todo
# link gerado aponta para a maquina de quem clicou, sem erro nenhum no log.
#   producao : https://www.nexventa.com.br
#   homolog  : a URL de branch da Vercel (estavel por branch, nao por deploy)
APP_FRONTEND_URL=https://preencher

# Lista separada por virgula. O SecurityConfig usa setAllowedOriginPatterns,
# entao curinga funciona — mas 'https://*.vercel.app' entra SO no .env de
# homologacao. Em producao qualquer projeto Vercel do mundo poderia chamar a API
# autenticada pelo navegador de um usuario logado.
CORS_ALLOWED_ORIGINS=https://preencher

# ---- Arquivos ---------------------------------------------------------------
# Caminho DENTRO do container. O bind mount do compose leva UPLOAD_HOST_DIR do
# host para ca, entao os dois precisam apontar para o mesmo lugar logico.
UPLOAD_DIR=/app/uploads

# Caminho NO HOST com os anexos antigos. Precisa pertencer ao uid 100 / gid 101
# (o usuario 'app' de dentro da imagem):
#     sudo chown -R 100:101 /app/uploads
UPLOAD_HOST_DIR=/app/uploads

# ---- S3 ---------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_S3_BUCKET=preencher
AWS_S3_BASE_URL=https://preencher.s3.amazonaws.com
AWS_ACCESS_KEY_ID=preencher
AWS_SECRET_ACCESS_KEY=preencher

# ---- Observabilidade --------------------------------------------------------
# Token que o Prometheus apresenta para ler /actuator/prometheus. Vazio deixa o
# endpoint recusando qualquer coletor (401) — foi o que aconteceu na primeira
# tentativa de subir a stack.
#
# O MESMO valor precisa estar em dois lugares:
#   1. aqui, que o backend le
#   2. em deploy/observability/metrics-token, que o Prometheus le
#
# Gerar e gravar nos dois de uma vez:
#   T=$(openssl rand -hex 32)
#   sed -i "s|^METRICS_SCRAPE_TOKEN=.*|METRICS_SCRAPE_TOKEN=$T|" .env
#   printf '%s' "$T" > observability/metrics-token && chmod 600 observability/metrics-token
#
# O arquivo NAO tem quebra de linha no fim de proposito: o Prometheus manda o
# conteudo inteiro como credencial, e um \n a mais faz o token nao bater.
METRICS_SCRAPE_TOKEN=

# Senha do admin do Grafana. Sem padrao no compose de proposito: variavel
# ausente derruba a subida com mensagem clara, em vez de deixar o painel do
# cliente aberto com 'admin/admin'.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=preencher

# Endereco publico do Grafana. Sem isto ele monta link de e-mail e redirect com
# http://localhost:3000 — mesmo modo de falha do APP_FRONTEND_URL, que passou
# meses errado em producao sem gerar um unico log.
#   homologacao: https://grafana-hml.nexventa.com.br
#   producao:    https://grafana.nexventa.com.br
GRAFANA_ROOT_URL=https://grafana-hml.nexventa.com.br

# Destinatario dos alertas provisionados (contact-points.yaml). Vazio provisiona
# o contato sem ninguem: o alerta aparece na tela do Grafana e nenhum e-mail sai.
ALERTA_EMAIL=

# ---- Recursos ---------------------------------------------------------------
# Teto de RAM do container do backend. 700m cabe na t2.micro de hoje (1 GB);
# subir para 1200m depois que a instancia virar t3.small (FABIANO-13).
BACKEND_MEM_LIMIT=700m

# SPRING_PROFILES_ACTIVE nao entra aqui de proposito: o compose ja o fixa em
# 'prod'. Deixar tambem no .env criaria dois lugares para a mesma decisao.
