# =============================================================================
# Variaveis do ambiente local — copie para .env e preencha
# =============================================================================
#
#   copy .env.example .env        (Windows)
#   cp   .env.example .env        (Linux/Mac)
#
# O arquivo .env NAO vai para o repositorio (ja esta no .gitignore, nas duas
# formas: ".env" e "*.env"). Este modelo vai, e serve de documentacao.
#
# O docker compose le o .env sozinho, sem nenhum parametro extra. Depois de
# editar, e preciso RECRIAR o container do Grafana para ele enxergar:
#
#   docker compose -f docker-compose.dev.yml --profile observabilidade up -d --force-recreate grafana
#
# =============================================================================


# -----------------------------------------------------------------------------
# ALERTAS POR E-MAIL (FABIANO-28)
# -----------------------------------------------------------------------------

# Para quem os alertas vao. Varios enderecos separados por ponto e virgula:
#   ALERTA_EMAIL=vini@empresa.com;fabiano@empresa.com
#
# Deixando em branco o Grafana RECUSA o arquivo de contatos inteiro e derruba
# junto as 8 regras de alerta — por isso o docker-compose tem um valor padrao
# inofensivo (alertas@localhost). Preencha com o endereco real.
ALERTA_EMAIL=

# Liga o envio. Com false, os alertas continuam sendo avaliados e ficam
# visiveis em http://localhost:3000/alerting/list, mas nenhum e-mail sai.
# Esse e o padrao de propria: melhor nao enviar do que enviar para o lugar
# errado enquanto se testa.
SMTP_ENABLED=false

# Servidor de envio, no formato host:porta.
#   Gmail ........: smtp.gmail.com:587
#   Outlook ......: smtp.office365.com:587
#   Amazon SES ...: email-smtp.us-east-1.amazonaws.com:587
SMTP_HOST=

# Usuario e senha do servidor de envio.
#
# ATENCAO no Gmail: nao funciona com a senha normal da conta. E preciso ativar
# a verificacao em duas etapas e gerar uma "senha de app" de 16 caracteres em
# https://myaccount.google.com/apppasswords — e essa senha que vai aqui.
SMTP_USER=
SMTP_PASSWORD=

# Remetente que aparece no e-mail. Em muitos provedores precisa ser o MESMO
# endereco do SMTP_USER, ou um dominio verificado — senao o envio e recusado
# ou cai em spam.
SMTP_FROM=alertas@nexventa.com.br
