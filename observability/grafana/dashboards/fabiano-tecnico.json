        "h": 13,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fabiano"
          },
          "expr": "sum by (uri, method) (increase(http_server_requests_seconds_count{job=\"fabiano-back\",uri!~\"/actuator.*\",uri=~\"${rota:regex}\"}[$__range]))",
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fabiano"
          },
          "expr": "sum by (uri, method) (increase(http_server_requests_seconds_count{job=\"fabiano-back\",uri!~\"/actuator.*\",uri=~\"${rota:regex}\",status=~\"[45]..\"}[$__range]))",
          "refId": "B",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fabiano"
          },
          "expr": "histogram_quantile(0.95, sum by (le, uri, method) (rate(http_server_requests_seconds_bucket{job=\"fabiano-back\",uri!~\"/actuator.*\",uri=~\"${rota:regex}\"}[$__range]))) > 0",
          "refId": "C",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
