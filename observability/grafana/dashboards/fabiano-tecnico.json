          "uid": "prometheus-fabiano"
        },
        "query": {
          "qryType": 1,
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "query": "label_values(http_server_requests_seconds_count{job=\"fabiano-back\",uri!~\"/actuator.*\"}, uri)"
        },
        "definition": "label_values(http_server_requests_seconds_count{job=\"fabiano-back\",uri!~\"/actuator.*\"}, uri)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
