    {
      "type": "table",
      "id": 4,
      "title": "Rotas mais lentas (p95 no periodo)",
      "description": "O '> 0' descarta NaN: rota sem observacao no intervalo faz histogram_quantile devolver NaN, e NaN entrava no topk ordenado acima de rotas realmente lentas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fabiano"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fabiano"
          },
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, uri, method) (rate(http_server_requests_seconds_bucket{job=\"fabiano-back\",uri!~\"/actuator.*\",uri=~\"${rota:regex}\"}[$__range]))) > 0)",
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "align": "auto"
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ]
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "job": true,
              "instance": true,
              "application": true,
              "environment": true,
              "outcome": true,
              "exception": true,
              "error": true
            },
            "renameByName": {
              "Value": "p95",
              "uri": "rota",
              "method": "metodo"
            }
          }
        }
      ]
    },
    {
      "type": "table",
      "id": 5,
      "title": "Rotas com mais erro (4xx e 5xx no periodo)",
      "description": "Vazio aqui e boa noticia, nao consulta quebrada: significa nenhum 4xx nem 5xx no intervalo.",
