    {
      "type": "timeseries",
      "id": 2,
      "title": "Requisicoes por segundo, por status",
      "description": "Empilhado: altura total e trafego, faixa de 5xx e falha.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fabiano"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fabiano"
          },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"fabiano-back\",uri!~\"/actuator.*\",uri=~\"${rota:regex}\"}[$__rate_interval]))",
          "refId": "A",
          "editorMode": "code",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 25,
            "showPoints": "never",
            "spanNulls": true,
            "gradientMode": "opacity",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Latencia",
      "description": "p99 muito acima do p95 aponta para uma minoria de chamadas presa em algo - quase sempre banco ou upload.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fabiano"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fabiano"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"fabiano-back\",uri!~\"/actuator.*\",uri=~\"${rota:regex}\"}[$__rate_interval])))",
          "refId": "A",
          "editorMode": "code",
          "legendFormat": "p50"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fabiano"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"fabiano-back\",uri!~\"/actuator.*\",uri=~\"${rota:regex}\"}[$__rate_interval])))",
          "refId": "B",
          "editorMode": "code",
          "legendFormat": "p95"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fabiano"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"fabiano-back\",uri!~\"/actuator.*\",uri=~\"${rota:regex}\"}[$__rate_interval])))",
          "refId": "C",
          "editorMode": "code",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
