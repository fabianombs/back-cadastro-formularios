        "h": 8,
        "w": 12,
        "x": 12,
        "y": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fabiano"
          },
          "expr": "topk(10, sum by (uri, method, status) (increase(http_server_requests_seconds_count{job=\"fabiano-back\",uri!~\"/actuator.*\",uri=~\"${rota:regex}\",status=~\"[45]..\"}[$__range])))",
          "refId": "A",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
