        "uid": "loki-fabiano"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki-fabiano"
          },
          "expr": "topk(10, sum by (logger) (count_over_time({application=\"fabiano-back\", nivel=~\"ERROR|WARN\"}[$__range])))",
