  "panels": [
    {
      "type": "stat",
      "id": 1,
      "title": "Linhas de log / min",
      "description": "Cair a zero com a aplicacao no ar significa que o Promtail parou, nao que o sistema ficou quieto. Vermelho no zero de proposito: com a aplicacao no ar, zero linha por minuto nao e calmaria, e o Promtail parado (FABIANO-62). O alerta 'Parei de receber log da aplicacao' cobre o mesmo caso para quem nao esta olhando.",
      "datasource": {
        "type": "loki",
        "uid": "loki-fabiano"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki-fabiano"
          },
          "expr": "sum(rate({application=\"fabiano-back\"}[5m])) * 60",
          "refId": "A",
          "editorMode": "code",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true
      }
    },
