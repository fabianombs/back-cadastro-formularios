    {
      "type": "stat",
      "id": 2,
      "title": "Erro 5xx",
      "description": "Percentual de respostas 5xx nos ultimos 5 minutos.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-fabiano"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-fabiano"
          },
          "expr": "100 * sum(rate(http_server_requests_seconds_count{job=\"fabiano-back\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"fabiano-back\"}[5m])), 0.001)",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
